# Generated by `bench proxy` -- do not edit by hand.
# Routes __ID__.__BASE__ to the target published on the host at :__HOST_PORT__.
server {
    listen 80;
    server_name __ID__.__BASE__;

    location / {
        proxy_pass http://host.docker.internal:__HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        # Rewrite absolute redirects back through the proxy host.
        proxy_redirect ~^https?://[^/]+(/.*)$ $scheme://$host$1;
    }
}
